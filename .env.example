# Copy to .env and fill in. Never commit .env.

# Server — Render sets PORT itself. Local default is 3024 (3015 is aivorah-assignments-service).
PORT=3024

# Supabase — service_role key (server only; bypasses RLS, see SETUP.md).
# SUPABASE_SERVICE_KEY is also accepted, matching the other aivorah services.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Firebase Admin — verifies the student's sign-in (Firebase ID token).
# Base64 of the service-account JSON (same variable the other services use).
FIREBASE_SERVICE_ACCOUNT_B64=your-base64-firebase-service-account-json

# enforce (default): requests about a student need that student's Firebase token.
# monitor: only logs what would be blocked — local development without Firebase only.
AUTH_ENFORCE=enforce

# "Today" for the digest and the quiz week (defaults to Asia/Kolkata).
CA_TIME_ZONE=Asia/Kolkata

# ── Content pipeline (scripts/generate-digest.js, scripts/generate-quiz.js) ──
# Groq — writes the age versions and quiz questions.
GROQ_API_KEY=your-groq-api-key
# Models tried in order on rate limits / errors.
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

{
  "name": "aivorah-current-affairs-service",
  "version": "1.0.0",
  "description": "Aivorah Current Affairs — daily child-friendly news digest, weekly quiz, points/streaks/badges",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "generate:digest": "node scripts/generate-digest.js",
    "generate:quiz": "node scripts/generate-quiz.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
